# ==============================================================================
# HORVVALLE E-COMMERCE CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Cloud Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://hrgvvsyalafdscponoca.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Payment Gateway Configuration
# Mode: "test" (mock / sandbox) or "live" (production real money)
PAYMENT_MODE=test

# Active Provider: "mock" | "stripe" | "payriff" | "pashabank"
PAYMENT_PROVIDER=mock

# Enable / Disable Cash On Delivery (Çatdırılmada Nağd/Kartla Ödəniş)
ENABLE_COD=true

# Apple Pay Merchant Configuration (Live mode only)
APPLE_PAY_MERCHANT_ID=merchant.com.horvvalle
APPLE_PAY_CERTIFICATE_PEM=""
APPLE_PAY_PRIVATE_KEY_PEM=""

# Provider Webhook Secrets (For signature verification)
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Admin Authentication
ADMIN_SECRET_KEY=horvvalle_super_secret_admin_key_2026
ADMIN_PASSWORD=admin
# Secret access key for admin panel (without this, /admin returns 404)
ADMIN_ACCESS_KEY=your_secret_admin_access_key

# Google Analytics & Search Console
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
