# ==============================================================================
# HORWALLE — environment variables
# Copy to .env.local for development. Never commit real values.
# ==============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (the only database) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required: every API route reads and writes through it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel (all four are required; there are no built-in defaults) -------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string that signs admin sessions. Changing it signs everyone out.
ADMIN_JWT_SECRET=
# Secret part of the admin link: /admin?access=<ADMIN_ACCESS_KEY>
ADMIN_ACCESS_KEY=

# --- Payments ------------------------------------------------------------------
# "test" (default, no real money) or "live"
PAYMENT_MODE=test
NEXT_PUBLIC_PAYMENT_MODE=test
# "mock" | "epoint"
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
APPLE_PAY_MERCHANT_ID=

# --- E-mail (order confirmations, status updates, campaigns) --------------------
# Without RESEND_API_KEY no e-mail is sent.
RESEND_API_KEY=
EMAIL_FROM="HORWALLE <orders@horwalle.com>"

# --- Order notifications to Telegram --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional -------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
